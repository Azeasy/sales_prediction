# Forecasto API token — required only when data.source=api in config
FORECASTO_TOKEN=your_token_here

# LLM API key for clean-data (env var name from config llm.api_key_env, default: DEEPSEEK_API_KEY)
# DEEPSEEK_API_KEY=your_key_here

# Optional: override config file path
# CONFIG_PATH=configs/base.yaml
